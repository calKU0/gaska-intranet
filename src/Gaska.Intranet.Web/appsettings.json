{
  "Database": {
    "MigrateOnStartup": true
  },
  "ActiveDirectory": {
    "Provider": "ActiveDirectory",
    "Domain": "",
    "ServiceAccount": {
      "UserName": "",
      "Password": ""
    },
    "EmployeesSearchBase": "",
    "EmployeesExtraFilter": "(givenName=*)(sn=*)",
    "EmployeesExcludedAccounts": [ "svc-*", "svc_*", "HealthMailbox*", "SM_*", "*$" ],
    "EmployeesExcludedContainers": [],
    "EmployeesGroup": "",
    "AdministratorGroups": [ "DomainAdmins" ],
    "EmployeesCacheMinutes": 15,
    "SessionRefreshMinutes": 30,
    "Attributes": {
      "Department": "department",
      "JobTitle": "title",
      "MobilePhone": "mobile",
      "Extension": "ipPhone",
      "Email": "mail"
    }
  },
  "Sms": {
    "Enabled": true,
    "Endpoint": "",
    "SuccessResponse": "Wysłano do centrali",
    "TimeoutSeconds": 15
  },
  "Smtp": {
    "Enabled": true,
    "Host": "",
    "Port": 465,
    "Security": "Auto",
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Gąska Intranet"
  },
  "TwoFactor": {
    "CodeLength": 6,
    "CodeLifetimeMinutes": 5,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 30,
    "MaxCodesPer15Minutes": 5,
    "MaxPasswordFailuresPer15Minutes": 5,
    "MaxPasswordFailuresPerIpPer15Minutes": 20,
    "TrustedDeviceDays": 5,
    "RequireAuthenticatorApp": true,
    "AuthenticatorIssuer": "Gaska Intranet",
    "AuthenticatorImageUrl": ""
  },
  "Session": {
    "IdleTimeoutMinutes": 60,
    "AbsoluteTimeoutHours": 12
  },
  "Security": {
    "InternalNetworks": [],
    "AdminOnlyFromInternalNetwork": true,
    "TrustedProxies": [],
    "LoginAttemptsPerMinutePerIp": 10,
    "ProtectKeysWithDpapi": false,
    "RequestsPerMinutePerIp": 600
  },
  "QuickLinks": [],
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/intranet-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "Glpi": {
    "BaseUrl": "",
    "ApiVersion": "v2.3",
    "Attachments": {
      "MaxFileMegabytes": 10,
      "MaxFiles": 10
    }
  },
  "AllowedHosts": "*"
}
