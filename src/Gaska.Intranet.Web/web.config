<?xml version="1.0" encoding="utf-8"?>
<!-- IIS settings. On "dotnet publish" the SDK fills in the aspNetCore section with the correct paths. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Gaska.Intranet.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />

      <!-- Blazor Server needs WebSockets: install the IIS feature "WebSocket Protocol" (on by default once installed).
           Do NOT add <webSocket> here – that section is locked at server level and IIS answers every request with
           500.19 (0x80070021). -->

      <security>
        <!-- Hide the "Server: Microsoft-IIS/10.0" header and limit request size (the app does not accept uploads). -->
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="1048576" maxQueryString="2048" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
