@* A chart in its card: icon and title, the period, the chart itself and – under it – what exactly it shows.
   The dashboard adds its drag handle and menu through Actions. *@
@inject IAnalyticsService Analytics
@inject TimeProvider Clock

<MudPaper Elevation="0" Class="@($"gaska-card gaska-widget gaska-series-{Slot}{(Settings.Chart == ChartKind.Number ? " gaska-widget--kpi" : null)}")">
    <div class="gaska-widget-head">
        <span class="gaska-widget-icon"><MudIcon Icon="@MetricIcons.For(_metric)" Size="Size.Small" /></span>
        <div class="gaska-widget-titles">
            <div class="gaska-widget-title">@(Settings.Title ?? _metric?.Title ?? "Wykres")</div>
            <div class="gaska-widget-period">@Caption</div>
        </div>
        @Actions
    </div>

    <div class="gaska-widget-body">
        <MetricView Settings="Settings" PeriodOverride="PeriodOverride" Contractor="Contractor" Compact="Compact" Height="Height" />
    </div>

    @if (_metric is not null)
    {
        <div class="gaska-widget-foot">
            <span>@_metric.Description</span>
            @if (!string.IsNullOrEmpty(_metric.Source))
            {
                <span class="gaska-widget-source">@_metric.Source</span>
            }
        </div>
    }
</MudPaper>

@code {
    private MetricDefinition? _metric;

    [Parameter, EditorRequired]
    public WidgetInput Settings { get; set; } = default!;

    [Parameter]
    public PeriodPreset? PeriodOverride { get; set; }

    [Parameter]
    public ContractorRef? Contractor { get; set; }

    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public int Height { get; set; } = 220;

    /// <summary>Buttons at the right end of the header (drag handle, menu).</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    private int Slot => Settings.Color is >= 1 and <= 8 ? Settings.Color : 1;

    /// <summary>"Ostatnie 12 miesięcy · 1.12.2025 – 13.11.2026"; a state as of today has no period.</summary>
    private string Caption
    {
        get
        {
            if (_metric is { AsOfNow: true })
            {
                return "Stan na dziś";
            }

            var preset = PeriodOverride ?? Settings.Period;
            var range = Periods.Resolve(preset, DateOnly.FromDateTime(Clock.GetLocalNow().DateTime), Settings.CustomFrom, Settings.CustomTo);
            return preset == PeriodPreset.Custom ? Periods.Describe(range) : $"{Periods.Name(preset)} · {Periods.Describe(range)}";
        }
    }

    protected override void OnParametersSet() => _metric = Analytics.Find(Settings.MetricKey);
}
