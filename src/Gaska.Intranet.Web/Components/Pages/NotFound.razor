@page "/nie-znaleziono"
@attribute [AllowAnonymous]

<PageTitle>Nie znaleziono · Gąska Intranet</PageTitle>

<div class="gaska-empty-state">
    <MudText Typo="Typo.h2" Class="gaska-404">404</MudText>
    <MudText Typo="Typo.h5" Class="mt-2">Nie znaleziono strony</MudText>
    <MudText Typo="Typo.body1" Class="mt-2 mud-text-secondary">Strona, której szukasz, nie istnieje lub została przeniesiona.</MudText>
    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="mt-6" StartIcon="@Icons.Material.Filled.Home">
        Strona główna
    </MudButton>
</div>
