@page "/dashboardy"
@page "/dashboardy/{DashboardId:int}"
@attribute [ModuleAuthorize(ModuleKeys.Dashboards)]
@implements IAsyncDisposable
@inject IDashboardService Service
@inject IAnalyticsService Analytics
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(_current?.Name ?? "Dashboardy") · Gąska Intranet</PageTitle>

<PageHeader Title="Dashboardy" Subtitle="Twoje własne strony z wykresami – widzisz je tylko Ty.">
    <Actions>
        @if (_current is not null)
        {
            <MudSelect T="PeriodPreset?" Value="_periodOverride" ValueChanged="p => _periodOverride = p" Label="Okres dla całej strony"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="gaska-dash-period" Clearable="true"
                       Placeholder="Wg ustawień wykresów">
                @foreach (var (preset, name) in Periods.Presets.Where(p => p.Preset != PeriodPreset.Custom))
                {
                    <MudSelectItem T="PeriodPreset?" Value="preset">@name</MudSelectItem>
                }
            </MudSelect>
            <MudButton OnClick="() => EditHeadingAsync(null)" Variant="Variant.Outlined" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Outlined.Title">Grupa</MudButton>
            <MudButton OnClick="() => EditWidgetAsync(null)" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AddChart">Dodaj wykres</MudButton>
        }
    </Actions>
</PageHeader>

<FormError Message="@_error" Class="mb-4" />

@if (_dashboards is null)
{
    <PageSkeleton Kind="PageSkeleton.SkeletonKind.List" ShowTitle="false" Rows="3" />
}
else if (_dashboards.Count == 0)
{
    <MudPaper Elevation="0" Class="gaska-card pa-6">
        <MudText Typo="Typo.h6">Utwórz swoją pierwszą stronę</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Strona to zestaw wykresów na jeden temat – np. sprzedaż albo klienci i ich aktywność. Możesz mieć ich kilka i
            przełączać się między nimi. Zacznij od gotowego zestawu albo od pustej strony.
        </MudText>

        @if (_metrics.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                Nie masz jeszcze dostępu do żadnych danych, więc nie dodasz wykresów. Poproś administratora o nadanie uprawnień
                (Uprawnienia → Dostęp do danych).
            </MudAlert>
        }

        <div class="gaska-metric-list gaska-metric-list--start">
            @foreach (var template in _templates)
            {
                <button type="button" class="gaska-metric" @onclick="() => NewDashboardAsync(template)">
                    <MudIcon Icon="@Icons.Material.Outlined.Dashboard" />
                    <span class="gaska-metric-text">
                        <span class="gaska-metric-title">@template.Name</span>
                        <span class="gaska-metric-desc">@template.Description</span>
                    </span>
                </button>
            }
            <button type="button" class="gaska-metric" @onclick="() => NewDashboardAsync(null)">
                <MudIcon Icon="@Icons.Material.Outlined.Add" />
                <span class="gaska-metric-text">
                    <span class="gaska-metric-title">Pusta strona</span>
                    <span class="gaska-metric-desc">Sam wybierzesz wykresy.</span>
                </span>
            </button>
        </div>
    </MudPaper>
}
else
{
    <div class="gaska-dash-tabs" role="tablist" aria-label="Strony z wykresami">
        @foreach (var dashboard in _dashboards)
        {
            <a href="@($"/dashboardy/{dashboard.Id}")" role="tab" aria-selected="@(dashboard.Id == _current?.Id ? "true" : "false")"
               class="gaska-dash-tab @(dashboard.Id == _current?.Id ? "is-active" : null)">@dashboard.Name</a>
        }
        <MudTooltip Text="Nowa strona">
            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" aria-label="Nowa strona" OnClick="() => NewDashboardAsync(null)" />
        </MudTooltip>
        <span class="flex-grow-1"></span>
        @if (_current is not null)
        {
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" AriaLabel="Opcje strony" Dense="true"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <MudMenuItem Icon="@Icons.Material.Outlined.Edit" OnClick="RenameAsync">Zmień nazwę strony</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Delete" OnClick="DeleteAsync">Usuń stronę</MudMenuItem>
            </MudMenu>
        }
    </div>

    @if (_current is null)
    {
        <div class="gaska-empty-state">
            <MudText Typo="Typo.h6">Nie ma takiej strony</MudText>
            <MudButton Href="/dashboardy" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Pokaż moje strony</MudButton>
        </div>
    }
    else if (_current.Widgets.Count == 0)
    {
        <div class="gaska-empty-state">
            <MudIcon Icon="@Icons.Material.Outlined.AddChart" Size="Size.Large" Class="mud-text-secondary" />
            <MudText Typo="Typo.h6" Class="mt-2">Ta strona jest jeszcze pusta</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Dodaj pierwszy wykres – wybierzesz dane, okres i sposób pokazania.</MudText>
            <MudButton OnClick="() => EditWidgetAsync(null)" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                       StartIcon="@Icons.Material.Filled.AddChart">Dodaj wykres</MudButton>
        </div>
    }
    else
    {
        @* The key makes a fresh grid per page, so the entrance animation plays when switching pages. *@
        <div class="gaska-dash-wrap" @key="_current.Id">
            <div class="gaska-dash-grid" @ref="_grid">
                @foreach (var widget in _current.Widgets)
                {
                    <div class="gaska-dash-cell gaska-dash-cell--@(widget.Kind == WidgetKind.Heading ? "full" : widget.Width.ToString().ToLowerInvariant())"
                         data-widget-id="@widget.Id" @key="widget.Id">
                        @if (widget.Kind == WidgetKind.Heading)
                        {
                            <div class="gaska-dash-heading">
                                <div class="gaska-dash-heading-text">
                                    <h2>@widget.Title</h2>
                                    @if (!string.IsNullOrWhiteSpace(widget.Description))
                                    {
                                        <p>@widget.Description</p>
                                    }
                                </div>
                                @WidgetActions(widget)
                            </div>
                        }
                        else
                        {
                            <MetricCard Settings="widget.ToInput()" PeriodOverride="_periodOverride" Actions="WidgetActions(widget)"
                                        Compact="@(widget.Width is WidgetWidth.Small or WidgetWidth.Quarter)" />
                        }
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private IReadOnlyList<Dashboard>? _dashboards;
    private Dashboard? _current;
    private IReadOnlyList<MetricDefinition> _metrics = [];
    private IReadOnlyList<DashboardTemplate> _templates = [];
    private PeriodPreset? _periodOverride;
    private ClaimsPrincipal _user = new();
    private string _sid = string.Empty;
    private string? _error;

    private ElementReference _grid;
    private string? _sortableGrid;
    private bool _settleOrder;
    private IJSObjectReference? _module;
    private DotNetObjectReference<DashboardsPage>? _self;

    [Parameter]
    public int? DashboardId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    /// <summary>Drag handle and menu of a chart or a group heading.</summary>
    private RenderFragment WidgetActions(DashboardWidget widget) =>
        @<div class="gaska-widget-actions">
            <button type="button" class="gaska-drag-handle" data-drag-handle title="Przeciągnij, aby przenieść" aria-label="Przeciągnij, aby przenieść">
                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
            </button>
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" AriaLabel="Opcje" Dense="true"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <MudMenuItem Icon="@Icons.Material.Outlined.Edit"
                             OnClick="() => widget.Kind == WidgetKind.Heading ? EditHeadingAsync(widget) : EditWidgetAsync(widget)">Zmień</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.ArrowUpward" OnClick="() => MoveWidgetAsync(widget, -1)">Przesuń wcześniej</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.ArrowDownward" OnClick="() => MoveWidgetAsync(widget, 1)">Przesuń dalej</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Delete" OnClick="() => RemoveWidgetAsync(widget)">Usuń</MudMenuItem>
            </MudMenu>
        </div>;

    protected override async Task OnParametersSetAsync()
    {
        // The interactive render loads the data – the pre-render only shows the skeleton.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        if (_dashboards is null)
        {
            _user = (await AuthState).User;
            _sid = _user.GetSid();
            _metrics = await Analytics.GetAvailableAsync(_user);

            // Ready-made sets without the charts this user may not see; a group heading stays only when a chart follows
            // it, and sets left without charts are not offered.
            var allowed = _metrics.Select(m => m.Key).ToHashSet();
            _templates = MetricCatalog.Templates
                .Select(t => t with { Widgets = Permitted(t.Widgets, allowed) })
                .Where(t => t.Widgets.Count > 0)
                .ToList();

            await ReloadAsync();
        }

        Select();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_current is not { Widgets.Count: > 0 })
        {
            _sortableGrid = null;
            return;
        }

        try
        {
            // A new grid element (first chart added, another page opened) needs its own drag-and-drop listeners.
            if (_grid.Id != _sortableGrid)
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/dashboard.js");
                _self ??= DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("init", _grid, _self);
                _sortableGrid = _grid.Id;
            }

            if (_settleOrder && _module is not null)
            {
                _settleOrder = false;
                await _module.InvokeVoidAsync("settle", _grid);
            }
        }
        catch (JSDisconnectedException)
        {
            // The user left the page – nothing to set up.
        }
    }

    /// <summary>Called by js/dashboard.js after a chart was dropped in a new place.</summary>
    [JSInvokable]
    public async Task OnReordered(int[] widgetIds)
    {
        if (_current is not { } dashboard)
        {
            return;
        }

        await RunAsync(async () =>
        {
            await Service.ReorderWidgetsAsync(_sid, dashboard.Id, widgetIds);
            await ReloadAsync();
        });
        _settleOrder = true;
        StateHasChanged();
    }

    private static List<WidgetInput> Permitted(IReadOnlyList<WidgetInput> widgets, HashSet<string> allowed)
    {
        var result = new List<WidgetInput>();
        foreach (var widget in widgets)
        {
            if (widget.Kind == WidgetKind.Heading)
            {
                // A heading directly after another heading means the previous group came out empty.
                if (result.Count > 0 && result[^1].Kind == WidgetKind.Heading)
                {
                    result.RemoveAt(result.Count - 1);
                }

                result.Add(widget);
            }
            else if (allowed.Contains(widget.MetricKey))
            {
                result.Add(widget);
            }
        }

        if (result.Count > 0 && result[^1].Kind == WidgetKind.Heading)
        {
            result.RemoveAt(result.Count - 1);
        }

        return result;
    }

    private async Task ReloadAsync()
    {
        _dashboards = await Service.GetAsync(_sid);
        Select();
    }

    private void Select() =>
        _current = DashboardId is { } id ? _dashboards?.FirstOrDefault(d => d.Id == id) : _dashboards?.FirstOrDefault();

    private async Task NewDashboardAsync(DashboardTemplate? template)
    {
        var parameters = new DialogParameters<DashboardPageDialog>
        {
            { d => d.Templates, _templates },
            { d => d.Template, template },
        };

        var dialog = await Dialogs.ShowAsync<DashboardPageDialog>("Nowa strona", parameters, CrmDialogs.Options);
        if (await dialog.Result is not { Canceled: false, Data: DashboardPageDialog.Result result })
        {
            return;
        }

        await RunAsync(async () =>
        {
            var created = await Service.CreateAsync(_sid, _user.Identity?.Name ?? string.Empty, result.Name, result.Template?.Widgets);
            await ReloadAsync();
            Navigation.NavigateTo($"/dashboardy/{created.Id}");
        });
    }

    private async Task RenameAsync()
    {
        if (_current is not { } dashboard)
        {
            return;
        }

        var parameters = new DialogParameters<DashboardPageDialog>
        {
            { d => d.Name, dashboard.Name },
            { d => d.Rename, true },
        };

        var dialog = await Dialogs.ShowAsync<DashboardPageDialog>("Zmiana nazwy strony", parameters, CrmDialogs.Options);
        if (await dialog.Result is { Canceled: false, Data: DashboardPageDialog.Result result })
        {
            await RunAsync(async () =>
            {
                await Service.RenameAsync(_sid, dashboard.Id, result.Name);
                await ReloadAsync();
            });
        }
    }

    private async Task DeleteAsync()
    {
        if (_current is not { } dashboard)
        {
            return;
        }

        var charts = dashboard.Widgets.Count(w => w.Kind == WidgetKind.Chart);
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Usunąć stronę?",
            $"Strona „{dashboard.Name}” zostanie usunięta razem z jej wykresami ({charts}). Tego nie da się cofnąć.",
            yesText: "Usuń", cancelText: "Anuluj");

        if (confirmed != true)
        {
            return;
        }

        await RunAsync(async () =>
        {
            await Service.DeleteAsync(_sid, dashboard.Id);
            await ReloadAsync();
            Snackbar.Add($"Usunięto stronę „{dashboard.Name}”.", Severity.Info);
            Navigation.NavigateTo("/dashboardy");
        });
    }

    private async Task EditWidgetAsync(DashboardWidget? widget)
    {
        if (_current is not { } dashboard)
        {
            return;
        }

        var parameters = new DialogParameters<WidgetDialog>
        {
            { d => d.Metrics, _metrics },
            { d => d.Existing, widget },
        };

        var dialog = await Dialogs.ShowAsync<WidgetDialog>(widget is null ? "Nowy wykres" : "Zmiana wykresu", parameters, WidgetDialog.Options);
        if (await dialog.Result is not { Canceled: false, Data: WidgetInput input })
        {
            return;
        }

        await RunAsync(async () =>
        {
            // The list only offers permitted data; checked again here, as permissions may have changed meanwhile.
            if (!await Analytics.CanViewAsync(_user, input.MetricKey))
            {
                throw new DashboardException("Nie masz dostępu do tych danych – wykres nie został zapisany.");
            }

            await SaveAsync(dashboard, widget, input);
        });
    }

    private async Task EditHeadingAsync(DashboardWidget? heading)
    {
        if (_current is not { } dashboard)
        {
            return;
        }

        var parameters = new DialogParameters<HeadingDialog> { { d => d.Existing, heading } };
        var dialog = await Dialogs.ShowAsync<HeadingDialog>(heading is null ? "Nowa grupa wykresów" : "Zmiana grupy", parameters, CrmDialogs.Options);
        if (await dialog.Result is { Canceled: false, Data: WidgetInput input })
        {
            await RunAsync(() => SaveAsync(dashboard, heading, input));
        }
    }

    private async Task SaveAsync(Dashboard dashboard, DashboardWidget? existing, WidgetInput input)
    {
        if (existing is null)
        {
            await Service.AddWidgetAsync(_sid, dashboard.Id, input);
        }
        else
        {
            await Service.UpdateWidgetAsync(_sid, existing.Id, input);
        }

        await ReloadAsync();
    }

    private async Task RemoveWidgetAsync(DashboardWidget widget)
    {
        await RunAsync(async () =>
        {
            await Service.RemoveWidgetAsync(_sid, widget.Id);
            await ReloadAsync();
            Snackbar.Add(widget.Kind == WidgetKind.Heading ? "Usunięto nagłówek grupy." : "Usunięto wykres.", Severity.Info);
        });
    }

    private async Task MoveWidgetAsync(DashboardWidget widget, int direction)
    {
        await RunAsync(async () =>
        {
            await Service.MoveWidgetAsync(_sid, widget.Id, direction);
            await ReloadAsync();
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _error = null;
        try
        {
            await action();
        }
        catch (DashboardException ex)
        {
            _error = ex.Message;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone – the browser has dropped the module already.
        }

        _self?.Dispose();
    }
}
